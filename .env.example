# ExifFlow Access Broker configuration.
# Copy to `.env` and fill in. Secrets in `.env` are never committed.
# The broker loads `.env` from the current working directory at startup.

BROKER_HOST=0.0.0.0
BROKER_PORT=8700
BROKER_DB=data/access-broker.db
BROKER_TOML=data/access-broker.toml
BROKER_TRUST_PROXY=0

BROKER_UI_ENABLED=1
BROKER_UI_HOST=127.0.0.1
BROKER_UI_PORT=8701

# Master key for storage-credential encryption. Generate with `access-broker keygen`.
# Either inline, or point BROKER_MASTER_KEY_FILE at a file containing the key.
#BROKER_MASTER_KEY=
#BROKER_MASTER_KEY_FILE=data/master.key
