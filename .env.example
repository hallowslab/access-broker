# ExifFlow Relay configuration.
# Copy to `.env` and fill in. Secrets in `.env` are never committed.
# The relay loads `.env` from the current working directory at startup.

RELAY_HOST=0.0.0.0
RELAY_PORT=8700
RELAY_DB=data/relay.db
RELAY_TOML=data/relay.toml
RELAY_TRUST_PROXY=0

RELAY_UI_ENABLED=1
RELAY_UI_HOST=127.0.0.1
RELAY_UI_PORT=8701

# Master key for storage-credential encryption. Generate with `relay keygen`.
# Either inline, or point RELAY_MASTER_KEY_FILE at a file containing the key.
#RELAY_MASTER_KEY=
#RELAY_MASTER_KEY_FILE=data/master.key
